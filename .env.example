# Yard Manager settings.
# Copy this file to ".env" (in the same folder) and change what you need.
# Lines starting with # are ignored; remove the # to use a setting.
# ".env" is not stored in git, so passwords in it stay on this server.
# Restart the server after changing it.

# ---- Web server ----
# Port the app listens on (443 is the normal https port).
#PORT=3000

# ---- HTTPS ----
# Use a certificate from IT. Either a .pfx file and its password ...
#HTTPS_PFX=C:\YardManager\certs\yard.pfx
#HTTPS_PASSPHRASE=the-pfx-password
# ... or a certificate and its key in PEM format (.crt/.pem + .key).
#HTTPS_CERT=C:\YardManager\certs\yard.crt
#HTTPS_KEY=C:\YardManager\certs\yard.key
# Also listen for plain http on this port and send visitors on to https.
#HTTP_REDIRECT_PORT=80

# ---- Data ----
# Folder holding the database file yard.db.
#DATA_DIR=C:\YardManager\data

# ---- Backups ----
# Folder for the nightly copies. Best on another drive or a network share.
#BACKUP_DIR=\\fileserver\share\YardManager\backups
# Time of the nightly copy, and how many copies to keep.
#BACKUP_TIME=02:00
#BACKUP_KEEP=30

# ---- First start ----
# When there is no admin yet, the server creates one with this username and
# temporary password (default admin / Test1234). It must be changed at first login.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=
